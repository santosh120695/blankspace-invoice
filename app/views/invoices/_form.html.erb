<%= form_with(model: invoice, local: true) do |form| %>
  <div class="form-group">
    <%= form.label :invoice_no %>
    <%= form.text_field :invoice_no, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :invoice_date %>
    <%= form.text_field :invoice_date, class: "form-control", required: true %>
  </div>

  <%= render "invoice_additional_fields"%>
  <div class="form-group">
    <table class="table">
      <thead>
        <tr>
          <th style="width:50%">Product</th>
          <th>Quantity</th>
          <th>Per Unit Price</th>
        </tr>
      </thead>
      <tbody id="sold-products">
        <%= form.fields_for :sold_products do |sold_product| %>
          <%= render "sold_product_fields", sold_product_field: sold_product%>
        <% end %>
        <tr>
          <td colspan="4">
            <%= link_to_add_association( form, :sold_products, {form_name: 'sold_product_field', class: "float-right"}) do %>
              <i class="fa fa-plus"></i>
            <%end%>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <%- if Configuration.find_by(key: "enable_discount").value == "1"%>
  <div class="form-group">
    <%= form.label :discount %>
    <%= form.number_field :discount, class: "form-control", required: true, value: Configuration.find_by(key: "discount").value %>
  </div>
  <%end%>
  
  <%- if Configuration.find_by(key: "enable_other_charges").value == "1"%>
  <div class="form-group">
    <%= form.label :other_charges %>
    <%= form.number_field :other_charges, class: "form-control", required: true, value: Configuration.find_by(key: "other_charges").value%>
  </div>
  <%end%>  

  <%- if Configuration.find_by(key: "enable_tax").value == "1"%>
    <div class="form-group">
      <%= form.label :tax %>
      <%= form.number_field :tax, class: "form-control", required: true, value:  Configuration.find_by(key: "tax").value%>
    </div>
  <%end%>

  <div class="form-group">
    <%= form.label :total_cost %>
    <%= form.number_field :total_cost, class: "form-control", required: true %>
  </div>

  <div class="form-group">
      <%= form.submit class: "btn btn-success pull-right" %>
  </div>
<% end %>

<script type="text/javascript">
  $('document').ready(function(){
    $(".add_fields").data("association-insertion-method","after").
    data("association-insertion-node", function(link){
      return $("#sold-products .item-fields").last()
    });
    $("#invoice_invoice_date").datepicker({
      format: 'dd/mm/yyyy',
    })
    fetch_all_products()
  })
</script>
