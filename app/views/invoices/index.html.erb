<div class="row">
  <div class="col-lg-3 col-md-6 col-sm-6">
      <div class="card card-stats">
          <div class="card-body ">
              <div class="row">
                  <div class="col-5 col-md-4">
                      <div class="icon-big text-center icon-warning">
                        <i class="fa fa-globe text-warning" aria-hidden="true"></i>
                      </div>
                  </div>
                  <div class="col-7 col-md-8">
                    <div class="numbers">
                      <p class="card-category">Total Sale</p>
                      <p class="card-title"> <%= @total_sales%>
                      </p><p>
                      </p></div>
                    </div>
                </div>
            </div>
            <div class="card-footer ">
             <hr>
            <div class="stats">
              <a href="/invoices">
                <i class="fa fa-refresh"></i> Update Now
              </a>
            </div>
            </div>
        </div>
  </div>
  <div class="col-lg-3 col-md-6 col-sm-6">
      <div class="card card-stats">
          <div class="card-body ">
              <div class="row">
                  <div class="col-5 col-md-4">
                      <div class="icon-big text-center icon-warning">
                        <!-- <i class="nc-icon nc-money-coins text-success"></i> -->
                        <i class="fa fa-money text-success" aria-hidden="true"></i>
                      </div>
                  </div>
                  <div class="col-7 col-md-8">
                    <div class="numbers">
                      <p class="card-category">Total Revenue</p>
                      <p class="card-title" >&#x20b9 <%=@total_revenue%>
                      </p><p>
                      </p></div>
                    </div>
                </div>
            </div>
            <div class="card-footer ">
             <hr>
            <div class="stats">
              <a href="/invoices">
                <i class="fa fa-refresh"></i> Update Now
              </a>
            </div>
            </div>
        </div>
  </div>
</div>

<div class="row">
  <div class="col-sm-12">
    <div class="card">
      <div class="card-header">
        <!-- <h1>Invoices</h1> -->
        <div class="card-title">
          <h4>Invoices</h4>
        </div>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Invoice Number</th>
                <th>Invoice Date</th>
                <th>Total Cost</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody>
              <% @invoices.each do |invoice| %>
                <tr>
                  <td><%= invoice.invoice_no %></td>
                  <td><%= invoice.invoice_date %></td>
                  <td><%= invoice.total_cost %></td>
                  <td><%= link_to 'Show', invoice %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer">
        
      </div>
    </div>
  </div>
</div>



<br>

<%#= link_to 'New Invoice', new_invoice_path %>
