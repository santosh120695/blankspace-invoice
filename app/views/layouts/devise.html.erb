<!DOCTYPE html>
<html>
  <head>
    <title>InvoiceApp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" rel="stylesheet">
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body style="background: url(<%= asset_path('header.jpg')%>) no-repeat center center fixed">
    <!-- <nav class="navbar navbar-expand-lg navbar-absolute fixed-top navbar-transparent">
    <div class="container">
    </div>
  </nav> -->
    <div class="wrapper wrapper-full-page" style="margin-top:4%">
      <div class="full-page section-image" filter-color="black">
        <div class="content">
          <div class="container">
            <div class="col-lg-4 col-md-6 ml-auto mr-auto">
              <%= yield%>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>