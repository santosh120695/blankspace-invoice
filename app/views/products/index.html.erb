<div class="row">
  <div class="col-sm-12">
    <div class="card">
      <div class="card-header">
        <h4>Products</h4>
      </div>
      <div class="card-body">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Product code</th>
              <th>Total available quantity</th>
              <th>Price</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @products.each do |product| %>
              <tr>
                <td><%= product.name %></td>
                <td><%= product.product_code %></td>
                <td><%= product.total_available_quantity %></td>
                <td><%= product.price %></td>
                <td><%= link_to 'Edit', edit_product_path(product) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <%= link_to 'New Product', new_product_path, class: "btn btn-success float-right" %>
      </div>
    </div>
  </div>
</div>
<!-- <br> -->

