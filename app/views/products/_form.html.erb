<%= form_with(model: product, local: true) do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
      <% product.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-fields">
    <%= form.label :name %>
    <%= form.text_field :name , class: "form-control"%>
  </div>

  <div class="form-fields">
    <%= form.label :product_code %>
    <%= form.text_field :product_code, class: "form-control" %>
  </div>

  <div class="form-fields">
    <%= form.label :total_available_quantity %>
    <%= form.number_field :total_available_quantity, class: "form-control" %>
  </div>

  <div class="form-fields">
    <%= form.label :price %>
    <%= form.number_field :price, class: "form-control" %>
  </div>

  <div class="form-fields">
    <%= form.submit class: "btn btn-success float-right" %>
  </div>
<% end %>
